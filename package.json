{
  "name": "yahha-ui",
  "version": "0.1.0",
  "description": "A manga-journal-inspired React component library for personal sites and stories.",
  "license": "MIT",
  "homepage": "https://github.com/didilili/yahha-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didilili/yahha-ui.git"
  },
  "bugs": {
    "url": "https://github.com/didilili/yahha-ui/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "npm run check:docs && npm run check:fonts && npm run build:demo:site",
    "build:demo:site": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "lint:package": "publint --strict",
    "test:package": "node scripts/test-package.mjs",
    "test:docs": "node scripts/test-docs.mjs",
    "test:adoption": "node scripts/test-docs.mjs --adoption",
    "create:starter": "node scripts/create-starter.mjs",
    "test:controls": "node scripts/test-docs.mjs --core-controls",
    "test:navigation": "node scripts/test-docs.mjs --navigation-controls",
    "test:overlays": "node scripts/test-docs.mjs --overlay-controls",
    "check": "npm run format:check && npm run lint && npm run check:scripts && npm run check:docs && npm run check:fonts && npm run check:design && npm run typecheck && npm test && npm run build:lib && npm run build:demo:site && npm run lint:package && npm run test:package && npm run test:docs && npm run test:fonts",
    "check:scripts": "node --experimental-strip-types --test tests/static-server.test.mjs tests/create-starter.test.mjs tests/doc-search.test.mjs tests/docs-navigation.test.mjs",
    "prepare": "husky",
    "check:design": "node --test tests/design-contract.test.mjs && node scripts/check-design.mjs && npm run check:artwork",
    "sync:artwork": "node scripts/sync-artwork.mjs",
    "check:artwork": "node --test tests/svg-defs.test.mjs tests/artwork-sync.test.mjs && node scripts/sync-artwork.mjs --check",
    "sync:docs": "node scripts/sync-component-docs.mjs",
    "check:docs": "node --test tests/documentation-contract.test.mjs && node scripts/sync-component-docs.mjs --check",
    "fonts:generate": "uv run scripts/build-fonts.py",
    "check:fonts": "node --test tests/fonts.test.mjs && node scripts/check-fonts.mjs",
    "test:fonts": "node scripts/test-fonts.mjs",
    "prepack": "npm run build:lib",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "17.6.0",
    "lucide-react": "^1.61.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
