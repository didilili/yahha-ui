{
  "name": "yahha-ui",
  "version": "0.0.1",
  "description": "A manga-journal-inspired React component library for personal sites and stories.",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "npm run check:fonts && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "lint:package": "publint --strict",
    "test:package": "node scripts/test-package.mjs",
    "test:docs": "node scripts/test-docs.mjs",
    "test:controls": "node scripts/test-docs.mjs --core-controls",
    "test:navigation": "node scripts/test-docs.mjs --navigation-controls",
    "test:overlays": "node scripts/test-docs.mjs --overlay-controls",
    "check": "npm run format:check && npm run lint && npm run check:docs && npm run check:fonts && npm run check:design && npm run typecheck && npm test && npm run build:lib && npm run build:demo && npm run lint:package && npm run test:package && npm run test:docs && npm run test:blog && npm run build:blog && npm run test:fonts",
    "prepare": "husky",
    "check:design": "node --test tests/design-contract.test.mjs && node scripts/check-design.mjs && npm run check:artwork",
    "sync:artwork": "node scripts/sync-little-days-artwork.mjs",
    "check:artwork": "node scripts/sync-little-days-artwork.mjs --check",
    "dev:blog": "npm run build:lib && vite --config examples/blog/vite.config.ts --host 127.0.0.1 --port 4186 --strictPort",
    "build:blog": "npm run check:fonts && npm run build:lib && tsc --noEmit -p examples/blog/tsconfig.json && vite build --config examples/blog/vite.config.ts",
    "preview:blog": "vite preview --config examples/blog/vite.config.ts --host 127.0.0.1 --port 4187 --strictPort",
    "test:blog": "node scripts/test-blog.mjs",
    "sync:docs": "node scripts/sync-component-docs.mjs",
    "check:docs": "node --test tests/documentation-contract.test.mjs && node scripts/sync-component-docs.mjs --check",
    "fonts:generate": "uv run scripts/build-fonts.py && npm run sync:fonts",
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "check:fonts": "node --test tests/fonts.test.mjs && node scripts/check-fonts.mjs",
    "test:fonts": "node scripts/test-fonts.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "17.6.0",
    "lucide-react": "^1.61.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
